{
  "name": "leadyen",
  "displayName": "Leadyen",
  "description": "B2B sales intelligence - find leads, enrich contacts, automate outreach",
  "version": "1.0.0",
  "author": {
    "name": "GetPlatform",
    "email": "plugins@getplatform.co",
    "url": "https://leadyen.com"
  },
  "repository": "https://github.com/hatlem/getplatform-plugins",
  "license": "MIT",
  "keywords": ["sales", "leads", "b2b", "prospecting", "enrichment", "outreach"],
  "commands": [
    {
      "name": "leadyen-search",
      "description": "Search for leads by company, role, or industry"
    },
    {
      "name": "leadyen-enrich",
      "description": "Enrich contact or company data"
    },
    {
      "name": "leadyen-sequence",
      "description": "Create and manage outreach sequences"
    }
  ],
  "skills": [
    {
      "name": "lead-finder",
      "description": "Find and enrich B2B leads"
    },
    {
      "name": "sales-outreach",
      "description": "Manage sales sequences and outreach"
    }
  ],
  "mcp": {
    "server": "./mcp/server.js",
    "config": {
      "apiKey": "${LEADYEN_API_KEY}",
      "baseUrl": "https://leadyen.com/api"
    }
  },
  "settings": {
    "LEADYEN_API_KEY": {
      "description": "Your Leadyen API key",
      "required": true,
      "secret": true
    }
  }
}
